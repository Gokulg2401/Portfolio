# Copy this file to "secrets.properties" (same folder) and fill in your values.
# secrets.properties is git-ignored, so your credentials never get committed.
#
# --- Option A: Gmail SMTP (good for local development) ---
# The password must be a Google *App Password*, not your normal Gmail password:
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password:     https://myaccount.google.com/apppasswords
#   3. Paste the 16-character code below (spaces are fine).
spring.mail.username=you@gmail.com
spring.mail.password=xxxx xxxx xxxx xxxx

# --- Option B: Resend HTTPS API (takes priority over SMTP when set) ---
# portfolio.mail.resend.api-key=re_xxxxxxxxxxxxxxxx
